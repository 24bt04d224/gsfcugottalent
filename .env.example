# GSFCU Got Talent - Environment Variables Example
# Backend URL (Choose your provider):
# - AWS EC2: http://<YOUR_EC2_PUBLIC_IP>:5000 (or http://<YOUR_EC2_PUBLIC_IP> if using Nginx reverse proxy)
# - Render: https://gsfcugottalent.onrender.com
# - Localhost: http://localhost:5000
VITE_BACKEND_URL=http://<YOUR_EC2_PUBLIC_IP>:5000

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@gsfcu-got-talent.g0rghi5.mongodb.net/?retryWrites=true&w=majority&appName=gsfcu-got-talent
MONGODB_DB=gsfcu_got_talent

# Firebase Authentication & Firestore Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Optional: Comma-separated admin emails
VITE_ADMIN_EMAILS=admin@gsfcu.ac.in,talent@gsfcu.ac.in
